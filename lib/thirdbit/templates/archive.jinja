{% extends "base.jinja" %}

{% block head_title %}
<title>{{site.title}} Archive {{node.year}}</title>
{% endblock %}

{% block page_title %}
<h1>Archive {{node.year}}</h1>
{% endblock %}

{% block content %}
{% for post in site._posts %}
{%- if post.date.year == node.year -%}<p>{{post.date}}: <a href="{{post.url}}">{{post.title}}</a></p>{%- endif -%}
{% endfor %}
{% endblock %}
